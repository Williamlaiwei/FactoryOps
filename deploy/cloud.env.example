# Copy to .env.cloud on the cloud server. Keep the real file out of the package.
SITE_ADDRESS=demo.example.com
REQUIRE_HTTPS=true
RELEASE_TAG=demo
# Use new random hexadecimal values. Do not use these placeholders unchanged.
POSTGRES_PASSWORD=replace-with-random-hex
KNOWLEDGE_POSTGRES_PASSWORD=replace-with-random-hex
FACTORYOPS_AI_KEY=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
