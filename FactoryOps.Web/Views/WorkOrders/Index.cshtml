@model List<FactoryOps.Web.Models.WorkOrder>
@{
    ViewData["Title"] = "Work Orders";
    int active = Model.Count(x => x.Status == "In Progress");
    int completed = Model.Count(x => x.Status == "Completed");
    int pending = Model.Count(x => x.Status == "Pending");
    var inventoryWarnings = ViewData["InventoryWarnings"] as Dictionary<int, List<string>> ?? new();
}

<div class="container mt-4">
    @if (TempData["OrderMessage"] is string message)
    {
        <div class="alert alert-info" role="status">@message</div>
    }
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1">Work Orders</h2>
            <p class="text-muted mb-0">Manage customer orders, delivery details and production status.</p>
        </div>
        <a asp-controller="WorkOrders" asp-action="New" class="btn btn-primary">+ Create Order</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card p-3"><div class="text-muted">Total Orders</div><h3 class="mb-0">@Model.Count</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted">Pending</div><h3 class="mb-0">@pending</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted">In Progress</div><h3 class="mb-0">@active</h3></div></div>
        <div class="col-md-3"><div class="card p-3"><div class="text-muted">Completed</div><h3 class="mb-0">@completed</h3></div></div>
    </div>
    <p class="small text-muted">Confirmed orders hold stock by delivery date. Production status does not move stock. Ship Order releases that order's holds and deducts actual stock; Cancel Order releases holds without changing actual stock.</p>

    <div class="card">
        <div class="card-body">
            <label for="orderSearch" class="form-label">Search orders</label>
            <input id="orderSearch" type="search" class="form-control mb-3"
                   placeholder="Order ID, customer, site, product or address..." autocomplete="off" />
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer / Site</th>
                            <th>Items</th>
                            <th>Delivery Date</th>
                            <th>Production Status</th>
                            <th>Holds / Shipment</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        @foreach (var order in Model)
                        {
                            var items = order.Items?.OrderBy(i => i.Id).ToList() ?? new List<FactoryOps.Web.Models.WorkOrderItem>();
                            var customerName = order.Customer?.CompanyName ?? "Legacy order";
                            var siteName = order.ConstructionSite?.SiteName ?? (order.DeliveryType == "Company" ? "Company address" : "Not assigned");
                            var itemSummary = items.Count > 0
                                ? string.Join(", ", items.Select(i => $"{i.ProductType} × {i.Quantity}"))
                                : $"{order.ProductType} × {order.Quantity}";
                            <tr class="order-row" data-order-id="@order.Id" data-search="@($"WO-{order.Id} {customerName} {siteName} {itemSummary} {order.DeliveryAddressSnapshot} {order.Status} {order.FulfillmentStatus}".ToLowerInvariant())">
                                <td class="fw-semibold">WO-@order.Id</td>
                                <td>
                                    <div class="fw-semibold">@customerName</div>
                                    <div class="text-muted small">@siteName</div>
                                </td>
                                <td class="order-items">
                                    @if (items.Count > 0)
                                    {
                                        @foreach (var item in items)
                                        {
                                            <div>@item.ProductType &times; @item.Quantity @item.UnitOfMeasureSnapshot</div>
                                        }
                                    }
                                    else
                                    {
                                        <div>@order.ProductType &times; @order.Quantity</div>
                                    }
                                </td>
                                <td>@order.DueDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <form asp-controller="WorkOrders" asp-action="UpdateStatus" method="post" class="d-flex flex-column gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <input type="hidden" name="version" value="@order.Version" />
                                        <select name="status" class="form-select form-select-sm" aria-label="Status for order WO-@order.Id">
                                            @foreach (var status in new[] { "Pending", "In Progress", "Completed" })
                                            {
                                                if (order.Status == status)
                                                {
                                                    <option value="@status" selected>@status</option>
                                                }
                                                else
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                    </form>
                                </td>
                                <td class="small">
                                    <strong class="d-block">@order.FulfillmentStatus</strong>
                                    @if (inventoryWarnings.TryGetValue(order.Id, out var stockWarnings))
                                    { foreach (var warning in stockWarnings) { <div class="text-danger">@warning</div> } }
                                    else if (order.FulfillmentStatus == "Reserved") { <span class="text-success">Held for @order.DueDate.ToString("yyyy-MM-dd")</span> }
                                    @if (order.FulfillmentStatus == "Historical") { <div class="text-muted">Earlier stock already accounted</div> }
                                    @if (order.ShippedAt.HasValue) { <div>Dispatched @order.ShippedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC</div> }
                                    <div class="d-flex flex-wrap gap-1 my-1">
                                        @if (order.FulfillmentStatus == "Reserved")
                                        {
                                            <form asp-action="Ship" method="post"><input type="hidden" name="id" value="@order.Id" /><input type="hidden" name="version" value="@order.Version" /><button class="btn btn-sm btn-success">Ship Order</button></form>
                                        }
                                        @if (order.FulfillmentStatus is "Unconfirmed" or "Cancelled")
                                        {
                                            <form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@order.Id" /><input type="hidden" name="version" value="@order.Version" /><button class="btn btn-sm btn-outline-primary">Confirm Hold</button></form>
                                        }
                                        @if (order.FulfillmentStatus is "Unconfirmed" or "Reserved")
                                        {
                                            <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@order.Id" /><input type="hidden" name="version" value="@order.Version" /><button class="btn btn-sm btn-outline-danger">Cancel Order</button></form>
                                        }
                                    </div>
                                    <div><a asp-controller="Inventory" asp-action="Calendar">View stock schedule</a></div>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Edit</a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse"
                                            data-bs-target="#orderDetails-@order.Id" aria-expanded="false"
                                            aria-controls="orderDetails-@order.Id">View</button>
                                </td>
                            </tr>
                            <tr class="order-detail-row">
                                <td colspan="7" class="p-0 border-0">
                                    <div class="collapse" id="orderDetails-@order.Id">
                                        <div class="p-3 bg-light border-bottom">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <h6>Products</h6>
                                                    <ul class="mb-0">
                                                        @if (items.Count > 0)
                                                        {
                                                            @foreach (var item in items)
                                                            {
                                                                <li>@item.ProductType — Quantity: @item.Quantity @item.UnitOfMeasureSnapshot @(string.IsNullOrEmpty(item.ProductSkuSnapshot) ? "" : $"(SKU: {item.ProductSkuSnapshot})")</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li>@order.ProductType — Quantity: @order.Quantity (legacy)</li>
                                                        }
                                                    </ul>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6>Delivery</h6>
                                                    <div><strong>Type:</strong> @(string.IsNullOrWhiteSpace(order.DeliveryType) ? "Not specified" : order.DeliveryType)</div>
                                                    <div><strong>Address:</strong> @(string.IsNullOrWhiteSpace(order.DeliveryAddressSnapshot) ? "Not recorded" : order.DeliveryAddressSnapshot)</div>
                                                    <div><strong>Instructions:</strong> @(string.IsNullOrWhiteSpace(order.DeliveryInstructions) ? "None" : order.DeliveryInstructions)</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p id="noMatchingOrders" class="text-muted d-none mb-0">No matching orders found.</p>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No orders yet. Use + Create Order to add the first one.</p>
            }
        </div>
    </div>
</div>

<script>
    const orderSearch = document.getElementById("orderSearch");
    orderSearch.addEventListener("input", () => {
        const query = orderSearch.value.trim().toLowerCase();
        let visible = 0;
        document.querySelectorAll("#ordersTableBody .order-row").forEach(row => {
            const match = row.dataset.search.includes(query);
            row.classList.toggle("d-none", !match);
            const detailsRow = row.nextElementSibling;
            if (detailsRow) detailsRow.classList.toggle("d-none", !match);
            if (match) visible++;
        });
        document.getElementById("noMatchingOrders").classList.toggle("d-none", visible !== 0 || query.length === 0);
    });
</script>
