@model List<FactoryOps.Web.Models.WorkOrder>
@{
    ViewData["Title"]="Work Orders";

}

<h1>Work Orders</h1>

<table class ="table">
    <thread>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Status</th>
        </th>
    </thread>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Title</td>
                <td>@order.Status</td>
            </tr>
        }
    </tbody>
</table>