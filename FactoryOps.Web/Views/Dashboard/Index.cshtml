@model InventoryDashboard
@inject FactoryOps.Web.Services.CompanyContext Company
@inject FactoryOps.Web.Services.BusinessClock Clock
@using System.Text.Json
@{ ViewData["Title"] = "Dashboard"; }
<div class="mt-4" id="stockDashboard" data-url="@Url.Action("Projection")" data-company="@Company.Key">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2>Inventory Dashboard</h2><p class="text-muted mb-0">Actual stock, incoming holds and confirmed order commitments by delivery date.</p></div><a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary">Manage Inventory</a></div>
    @if (Model.RiskProducts > 0 || Model.UnconfirmedOrders > 0)
    { <div class="alert alert-warning">@Model.RiskProducts product(s) need stock attention; @Model.UnconfirmedOrders order(s) need confirmation. <a asp-controller="WorkOrders" asp-action="Index">Review orders and holds</a>.</div> }
    <div class="card card-body">
        <form id="projectionControls" method="get" class="row g-3 align-items-end mb-3">
            <div class="col-md-8">
                <label for="stockProductSelect" id="stockProductLabel" class="form-label">Product</label>
                <div class="stock-product-picker">
                    <select id="stockProductSelect" name="productId" class="form-select">
                    @foreach (var item in Model.ProductPlans)
                    {
                        var product = item.Product; var label = $"{product.Sku} - {product.Name} ({product.UnitOfMeasure})";
                        <option value="@product.Id" data-label="@label" data-risk="@item.HasDashboardRisk.ToString().ToLowerInvariant()" data-status="@item.DashboardAlert" selected="@(product.Id == Model.SelectedProductId)">@label@(item.DashboardAlert != "Sufficient" ? " — " + item.DashboardAlert : "")</option>
                    }
                    </select>
                    <button type="button" id="stockProductButton" class="form-select stock-product-button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="stockProductOptions" aria-labelledby="stockProductLabel stockProductValue" hidden><span id="stockProductValue"></span></button>
                    <div id="stockProductOptions" class="stock-product-options" role="listbox" aria-labelledby="stockProductLabel" hidden></div>
                </div>
                <p class="small text-muted mt-1 mb-0">Red products need attention: shortages, reorder levels, overdue receipts or reliance on incoming stock.</p>
            </div>
            <div class="col-md-3"><label for="projectionMonths" class="form-label">Forecast Range</label><select id="projectionMonths" name="months" class="form-select"><option value="1" selected="@(Model.Months == 1)">Next 1 Month</option><option value="3" selected="@(Model.Months == 3)">Next 3 Months</option></select></div>
            <div class="col-md-1"><button class="btn btn-outline-primary w-100" type="submit" aria-label="Refresh forecast">View</button></div>
        </form>
        <div id="projectionError" class="alert alert-danger d-none" role="alert"></div>
        <div id="projectionNotice" class="alert alert-light border d-none" role="status"></div>
        <div class="row g-3 mb-3" aria-live="polite">
            <div class="col-sm-4"><div class="projection-stat projection-blue">Actual On Hand<strong id="projectionOnHand">-</strong></div></div>
            <div class="col-sm-4"><div class="projection-stat projection-green">Incoming Holds (All Dates)<strong id="projectionIncoming">-</strong></div></div>
            <div class="col-sm-4"><div class="projection-stat projection-red">Outbound Holds (All Dates)<strong id="projectionOutgoing">-</strong></div></div>
        </div>
        <p id="projectionTitle" class="fw-semibold mb-2"></p>
        <div class="d-flex flex-wrap gap-3 small mb-2" id="projectionLegend"><span class="projection-blue">Blue: actual on hand</span><span class="projection-green">Green: with incoming holds</span><span class="projection-red">Red: after outbound holds</span></div>
        <div id="stockChartHost" class="stock-chart-host"><svg id="stockProjectionChart" viewBox="0 0 1000 340" role="img" aria-labelledby="chartTitle chartDescription" tabindex="0"><title id="chartTitle">Inventory forecast</title><desc id="chartDescription">Blue shows today's actual stock as a fixed reference. Green adds expected receipts. Red also subtracts confirmed outbound holds. Use left and right arrow keys to inspect dates.</desc></svg></div>
        <div id="projectionTooltip" class="border rounded bg-light p-2 small" aria-live="polite"></div>
        <p class="small text-muted mt-3 mb-0">Dates use @Clock.ZoneId. The blue line is today's measured stock, held flat for reference. Green includes unreceived arrivals; red is projected availability after confirmed holds. Same-day arrivals are assumed before deliveries. Overdue incoming holds are excluded. Shipment always requires actual received stock.</p>
        <details class="mt-3"><summary>View Daily Projection Data</summary><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Date</th><th>Actual</th><th>With Incoming</th><th>After Outbound Holds</th><th>Incoming That Day</th><th>Held That Day</th></tr></thead><tbody id="projectionRows"></tbody></table></div></details>
        <div class="d-flex flex-wrap gap-2 mt-3"><a id="projectionStockLink" asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary">Stock Count / Details</a><a asp-controller="Inventory" asp-action="Schedule" class="btn btn-outline-success">Schedule Incoming Stock</a><a asp-controller="WorkOrders" asp-action="New" class="btn btn-primary">Create and Hold Order</a></div>
    </div>
    @if (!Model.Products.Any()) { <p class="mt-3">Add catalog products to begin tracking inventory.</p> }
    <script type="application/json" id="initialProjection">@Html.Raw(JsonSerializer.Serialize(Model.Projection, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
</div>
@section Scripts { <script src="~/js/stock-product-picker.js" asp-append-version="true"></script><script src="~/js/inventory-dashboard.js" asp-append-version="true"></script> }
