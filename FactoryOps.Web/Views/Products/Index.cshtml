@model FactoryOps.Web.Models.ProductIndexViewModel
@{ ViewData["Title"] = "Product Catalog"; }
<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div><h2>Product Catalog</h2><p class="text-muted mb-0">Manage product codes, specifications and ordering units.</p></div>
        <div class="d-flex gap-2"><a asp-action="Import" class="btn btn-outline-primary">Import Product CSV</a><a asp-action="Create" class="btn btn-primary">+ New Product</a></div>
    </div>
    @if (TempData["ProductMessage"] is string message)
    {
        <div class="alert alert-info" role="status">@message</div>
    }
    @if (Model.Products.Any(x => x.Sku.StartsWith("LEGACY-")))
    {
        <div class="alert alert-warning">Some existing products have temporary LEGACY codes and a default unit. Edit them to enter your company's actual SKU and ordering unit.</div>
    }
    <div class="card"><div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-7"><label asp-for="Q" class="form-label">Search SKU, name, specifications or alias</label><input asp-for="Q" name="q" type="search" class="form-control" placeholder="Product code, color, size or abbreviation..." /></div>
            <div class="col-md-3"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" name="status" class="form-select"><option value="all">All products</option><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" type="submit">Search</button></div>
        </form>
        <p class="text-muted">@Model.Products.Count product(s). Inactive products remain on historical orders.</p>
        <div class="table-responsive"><table class="table table-hover align-middle">
            <thead><tr><th>SKU / Product</th><th>Category</th><th>Product Information</th><th>Unit</th><th>Aliases</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr data-product-id="@product.Id">
                        <td><div class="fw-semibold">@product.Sku</div><div>@product.Name</div></td>
                        @* Demo codes are app identifiers, not verified manufacturer codes. *@
                        <td>@product.Category @if (product.IsDemo) { <span class="badge bg-warning text-dark">Demo</span> }</td>
                        <td class="small">@if (!string.IsNullOrWhiteSpace(product.Dimensions)) { <div>Size: @product.Dimensions</div> } @if (!string.IsNullOrWhiteSpace(product.PackingSize)) { <div>Packing: @product.PackingSize</div> } @if (!string.IsNullOrWhiteSpace(product.RoughIn)) { <div>Rough-in: @product.RoughIn</div> } @if (!string.IsNullOrWhiteSpace(product.Color)) { <div>Color: @product.Color</div> } @if (!string.IsNullOrWhiteSpace(product.CeramicBody)) { <div>Body: @product.CeramicBody</div> } @if (!string.IsNullOrWhiteSpace(product.NetWeight) || !string.IsNullOrWhiteSpace(product.GrossWeight)) { <div>Weight: @product.NetWeight net / @product.GrossWeight gross</div> }</td>
                        <td>@product.UnitOfMeasure</td><td>@string.Join(", ", product.Aliases.OrderBy(x => x.Value).Select(x => x.Value))</td>
                        <td><span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a></td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (!Model.Products.Any()) { <p class="text-muted mb-0">No products match. Add a product or import a CSV to populate the catalog.</p> }
    </div></div>
</div>
