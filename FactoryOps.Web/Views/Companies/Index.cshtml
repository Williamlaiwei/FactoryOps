@model List<FactoryOps.Web.Models.CompanyProfile>
@inject FactoryOps.Web.Services.CompanyContext Company
@{ ViewData["Title"] = "Company Profiles"; }
<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="mb-0">Company Profiles</h2>
        <a asp-action="Create" class="btn btn-primary">+ Create Company</a>
    </div>
    <p class="text-muted">Select a company or create a new one. Products, customers, sites, orders, AI settings and knowledge are kept separate.</p>
    @if (TempData["CompanyMessage"] is string message) { <div class="alert alert-info" role="status">@message</div> }
    <div class="row g-3 mb-4">
        @foreach (var profile in Model)
        {
            <div class="col-md-6"><div class="card h-100 company-profile" data-company-key="@profile.Key"><div class="card-body">
                <h5>@profile.Name</h5><p>@(profile.IsDemo ? "Demo product codes; no live stock or prices." : "Your own company data and knowledge documents.")</p>
                @if (profile.Key == Company.Key) { <span class="badge bg-success">Active company</span> }
                else { <form asp-action="Select" method="post"><input type="hidden" name="key" value="@profile.Key" /><button type="submit" class="btn btn-outline-primary">Use This Company</button></form> }
            </div></div></div>
        }
    </div>
    <div class="card"><div class="card-body">
        <h5>Settings for @Company.Profile.Name</h5>
        <form asp-action="Update" method="post">
            <label for="companyName" class="form-label">Company name</label><input id="companyName" name="name" value="@Company.Profile.Name" required maxlength="200" class="form-control mb-3" />
            <label for="companyWebsite" class="form-label">Website (optional)</label><input id="companyWebsite" name="website" value="@Company.Profile.Website" type="url" class="form-control mb-3" />
            <button type="submit" class="btn btn-primary">Save Company Settings</button>
        </form>
    </div></div>
</div>
